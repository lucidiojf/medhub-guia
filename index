        // Base de Dados de Prescrições e Protocolos
        const prescricoesData = [
            {"titulo": "Síndrome Coronariana Aguda - IAM (MONABECCH)", "categoria": "Cardio Urgência", "conteudo": "• Repouso no leito e monitorização contínua de ECG e SatO2.\n• Oxigênio se SatO2 < 90%.\n• Morfina: 2 a 4 mg EV a cada 15 min se dor refratária e PAS > 100 mmHg.\n• Nitrato: Isordil 5 mg SL (até 3 doses) se dor anginosa ativa e ausência de uso prévio de inibidor de fosfodiesterase.\n• AAS: 300 mg VO mastigáveis (3 comprimidos de 100 mg).\n• Clopidogrel: 300 mg VO (4 comprimidos de 75 mg) ou 600 mg se ICP primária.\n• Estatina: Atorvastatina 80 mg ou Sinvastatina 40 mg VO à noite.\n• Betabloqueador: Metoprolol 50 mg VO se hemodinamicamente estável.\n• Enoxaparina: 30 mg EV bolus + 1 mg/kg SC de 12/12h."},
            {"titulo": "Edema Agudo de Pulmão (EAP)", "categoria": "Cardio Urgência", "conteudo": "• Cabeceira elevada a 90° e pernas pendentes.\n• Furosemida: 40 a 80 mg EV em bolus imediato (dobrar em 30 min se necessário).\n• Vasodilatador: Nitroglicerina (Tridil) ou Nitroprussiato de Sódio (Nipride) em BIC se PAS > 110 mmHg.\n• Morfina: 2 a 4 mg EV para redução de pré-carga e alívio da dispneia.\n• Suporte ventilatório: VNI (CPAP/BIPAP com PEEP de 5 a 10 cmH2O) prioritária antes da IOT."},
            {"titulo": "Crise Asmática na Criança (Hospitalar)", "categoria": "Pediatria Urgência", "conteudo": "• Salbutamol spray 100 mcg com espaçador: 4 a 10 puffs a cada 20 min por 1 hora OU Nebulização: SF 4 ml + Salbutamol 1 gt/3 kg (máx 20 gts) + Ipratrópio 20 gts.\n• Corticoide oral imediato: Prednisolona 1 a 2 mg/kg (dose única no ataque).\n• Se sem via oral: Hidrocortisona 5 mg/kg EV de 6/6h ou Dexametasona 0,3 a 0,6 mg/kg IM/EV.\n• Manter SatO2 entre 94% e 98% com cânula nasal."},
            {"titulo": "Drogas Injetáveis de Urgência em Pediatria", "categoria": "Pediatria Urgência", "conteudo": "Regras práticas de beira de leito:\n• Adrenalina (PCR): 1 ampola + 9 ml ABD -> Fazer 0,1 ml/kg EV.\n• Adrenalina (Anafilaxia 1:1000 pura): 0,01 ml/kg IM no vasto lateral da coxa (máx 0,3 ml).\n• Diazepam (2ml/10mg): 0,04 ml/kg EV lento ou via retal 0,1 ml/kg.\n• Dexametasona (Decadron): Peso / 20 em ml IM ou EV.\n• Dipirona (1g/2ml): Peso / 20 em ml IM ou EV.\n• Ondansetrona (2mg/ml): Peso / 20 em ml EV lento.\n• Fenitoína (Hidantal): Ataque de 0,4 ml/kg diluído em SF em 30 min."},
            {"titulo": "Pneumonia Adquirida na Comunidade (Adulto)", "categoria": "Clínica Médica", "conteudo": "Tratamento em Enfermaria (CURB-65 = 2):\n• Ceftriaxona 1g EV de 12/12h ou 2g EV 1x/dia associada a Claritromicina 500 mg VO/EV 12/12h (ou Azitromicina 500 mg EV 1x/dia).\n• Hidratação venosa de manutenção: SF 1000 ml + SG 1000 ml em 24h.\n• Dipirona 1g EV de 6/6h se febre/dor.\n• Oxigenoterapia suplementar se SatO2 < 92%."},
            {"titulo": "Intubação Traqueal - Sequência Rápida (SRI)", "categoria": "Urgência", "conteudo": "Para paciente adulto padrão de 70 kg:\n• Pré-oxigenação com O2 a 100% por 3 a 5 min.\n• Pré-medicação: Fentanil 2 a 3 mcg/kg (Ex: 2 a 3 ml EV puro).\n• Indução: Etomidato 0,3 mg/kg (Ex: 1 ml para cada 10 kg = 7 ml EV) OU Cetamina 1,5 a 2 mg/kg.\n• Bloqueio neuromuscular: Succinilcolina 1 a 1,5 mg/kg (Ex: 1 amp de 100mg diluída para 10ml -> fazer 7 a 10 ml EV) ou Rocurônio 1,2 mg/kg EV."}
        ];

        // Base de Dados de DM e HAS
        const dmhasData = [
            {"titulo": "Hipertensão Arterial - Progressão Terapêutica", "categoria": "HAS", "conteudo": "• Etapa 1: Hipertenso Grau 1 com baixo risco: monoterapia (IECA, BRA, BCC ou Tiazídico). Grau 1 de alto risco ou Graus 2/3: iniciar associação de 2 classes de 1ª linha.\n• Etapa 2: Aumentar as doses ou associar 3ª classe: IECA/BRA + BCC + Diurético Tiazídico.\n• Etapa 3 (HAS Resistente): Adicionar Espironolactona (25 a 50 mg/dia) como 4ª droga.\n• Regra de Ouro: NUNCA associar IECA (Enalapril/Captopril) com BRA (Losartana/Valsartana)."},
            {"titulo": "HAS - Doses Ambulatoriais das Principais Classes", "categoria": "HAS", "conteudo": "• Enalapril: 5 a 40 mg/dia (1 a 2x/dia).\n• Losartana: 50 a 100 mg/dia (1 a 2x/dia).\n• Hidroclorotiazida: 12,5 a 25 mg/dia VO pela manhã.\n• Anlodipino: 2,5 a 10 mg/dia VO 1x/dia.\n• Espironolactona: 25 a 50 mg/dia VO 1x/dia.\n• Atenolol: 25 a 100 mg/dia (preferencial em cardiopatia isquêmica concomitante)."},
            {"titulo": "Diabetes Mellitus - Insulinização Ambulatorial", "categoria": "Diabetes", "conteudo": "• Início Basal: NPH 0,2 U/kg/dia ao deitar (ou Lantus 0,16 U/kg). Manter metformina.\n• Ajuste da Glicemia de Jejum (GJ): Se GJ fora da meta por 3 dias seguidos, aumentar 2 a 4 U na NPH noturna.\n• Pico Pós-Prandial Isolado: Adicionar Insulina Regular antes da refeição correspondente.\n• Esquema Pleno: Fracionar NPH em 2 doses (2/3 antes do café da manhã e 1/3 ao deitar) associada a doses prandiais de Regular."},
            {"titulo": "HAS - Escolha Medicamentosa em Populações Especiais", "categoria": "HAS", "conteudo": "• Pacientes Negros: Preferência por Tiazídicos e Bloqueadores de Canal de Cálcio (Anlodipino).\n• Diabéticos e Doença Renal Crônica: IECA ou BRA (nefroproteção).\n• Pós-Infarto / IC com FE reduzida: Betabloqueador + IECA/BRA + Espironolactona.\n• Gestantes: Metildopa (1ª escolha), Hidralazina ou Nifedipino de liberação lenta. Contraindicados IECA e BRA."}
        ];

        // Renderização dos cards
        function renderAll() {
            // 1. Fichas
            document.getElementById('lista-fichas').innerHTML = fichasData.map((f, i) => `
                <div class="search-card bg-white p-4 rounded-2xl border border-gray-100 shadow-sm cursor-pointer hover:border-indigo-200 transition-all" onclick="openModal('ficha', ${i})">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[10px] font-black uppercase tracking-wider text-rose-700 bg-rose-50 px-2 py-0.5 rounded-full">${f.id}</span>
                        <span class="text-gray-400 text-xs">Toque p/ abrir ➔</span>
                    </div>
                    <h3 class="text-sm font-bold text-gray-800">${f.nome}</h3>
                    <p class="text-[11px] text-gray-500 line-clamp-2 mt-1">${f.sintomas}</p>
                </div>
            `).join('');

            // 2. Antídotos
            document.getElementById('lista-antidotos').innerHTML = antidotosData.map((a, i) => `
                <div class="search-card bg-white p-4 rounded-2xl border border-gray-100 shadow-sm cursor-pointer hover:border-indigo-200 transition-all" onclick="openModal('antidoto', ${i})">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[10px] font-black uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">${a.apresentacao}</span>
                        <span class="text-gray-400 text-xs">Toque p/ abrir ➔</span>
                    </div>
                    <h3 class="text-sm font-bold text-gray-800">${a.nome}</h3>
                    <p class="text-[11px] text-indigo-900 font-semibold mt-1">Indicação: ${a.indicacao}</p>
                </div>
            `).join('');

            // 3. Peçonhentos
            document.getElementById('lista-peconha').innerHTML = peconhaData.map((p, i) => `
                <div class="search-card bg-white p-4 rounded-2xl border border-gray-100 shadow-sm cursor-pointer hover:border-indigo-200 transition-all" onclick="openModal('peconha', ${i})">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[10px] font-black uppercase tracking-wider text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full">${p.tipo}</span>
                        <span class="text-gray-400 text-xs">Toque p/ abrir ➔</span>
                    </div>
                    <h3 class="text-sm font-bold text-gray-800">${p.nome}</h3>
                    <p class="text-[11px] text-gray-500 line-clamp-2 mt-1">${p.quadro}</p>
                </div>
            `).join('');

            // 4. Prescrições
            document.getElementById('lista-prescricoes').innerHTML = prescricoesData.map((pr, i) => `
                <div class="search-card bg-white p-4 rounded-2xl border border-gray-100 shadow-sm cursor-pointer hover:border-indigo-200 transition-all" onclick="openModal('prescricao', ${i})">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[10px] font-black uppercase tracking-wider text-blue-700 bg-blue-50 px-2 py-0.5 rounded-full">${pr.categoria}</span>
                        <span class="text-gray-400 text-xs">Toque p/ abrir ➔</span>
                    </div>
                    <h3 class="text-sm font-bold text-gray-800">${pr.titulo}</h3>
                    <p class="text-[11px] text-gray-500 line-clamp-2 mt-1 whitespace-pre-line">${pr.conteudo}</p>
                </div>
            `).join('');

            // 5. DM & HAS
            document.getElementById('lista-dmhas').innerHTML = dmhasData.map((d, i) => `
                <div class="search-card bg-white p-4 rounded-2xl border border-gray-100 shadow-sm cursor-pointer hover:border-indigo-200 transition-all" onclick="openModal('dmhas', ${i})">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[10px] font-black uppercase tracking-wider text-purple-700 bg-purple-50 px-2 py-0.5 rounded-full">${d.categoria}</span>
                        <span class="text-gray-400 text-xs">Toque p/ abrir ➔</span>
                    </div>
                    <h3 class="text-sm font-bold text-gray-800">${d.titulo}</h3>
                    <p class="text-[11px] text-gray-500 line-clamp-2 mt-1 whitespace-pre-line">${d.conteudo}</p>
                </div>
            `).join('');
        }

        // Troca de Abas
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-50', 'text-indigo-700', 'border-indigo-500/20', 'border-2');
                btn.classList.add('text-gray-500', 'hover:bg-gray-100', 'border', 'border-transparent');
            });

            document.getElementById(tabId).classList.remove('hidden');
            const targetBtn = document.getElementById('btn-' + tabId);
            targetBtn.classList.remove('text-gray-500', 'hover:bg-gray-100', 'border', 'border-transparent');
            targetBtn.classList.add('bg-indigo-50', 'text-indigo-700', 'border-indigo-500/20', 'border-2');
        }

        // Filtro Geral de Pesquisa
        function filtrarGeral() {
            const query = document.getElementById('globalSearch').value.toLowerCase();
            const cards = document.querySelectorAll('.search-card');

            cards.forEach(card => {
                const text = card.textContent.toLowerCase();
                card.style.display = text.includes(query) ? 'block' : 'none';
            });
        }

        // Abertura do Modal de Detalhes
        function openModal(tipo, index) {
            const modal = document.getElementById('detailModal');
            const catBadge = document.getElementById('modalCategory');
            const body = document.getElementById('modalBody');

            if (tipo === 'ficha') {
                const item = fichasData[index];
                catBadge.innerText = item.id;
                body.innerHTML = `
                    <h2 class="text-base font-black text-gray-900">${item.nome}</h2>
                    <div>
                        <strong class="text-rose-800 uppercase text-[10px] block font-black">🚨 Sinais & Sintomas:</strong>
                        <p class="text-gray-700">${item.sintomas}</p>
                    </div>
                    <div>
                        <strong class="text-indigo-800 uppercase text-[10px] block font-black">🔬 Exames Sugeridos:</strong>
                        <p class="text-gray-700">${item.exames}</p>
                    </div>
                    <div>
                        <strong class="text-emerald-800 uppercase text-[10px] block font-black">💉 Tratamento & Antídotos:</strong>
                        <p class="text-gray-700">${item.tratamento}</p>
                    </div>
                `;
                activeModalData = `☣️ *CIATox / IJF - ${item.id}*\n*Substância:* ${item.nome}\n\n*Conduta/Tratamento:*\n${item.tratamento}`;
            } else if (tipo === 'antidoto') {
                const item = antidotosData[index];
                catBadge.innerText = "ANTÍDOTO";
                body.innerHTML = `
                    <h2 class="text-base font-black text-gray-900">${item.nome}</h2>
                    <p class="text-gray-500 font-semibold text-xs">${item.apresentacao}</p>
                    <div>
                        <strong class="text-indigo-800 uppercase text-[10px] block font-black">🎯 Indicação Principal:</strong>
                        <p class="text-gray-700">${item.indicacao}</p>
                    </div>
                    <div>
                        <strong class="text-emerald-800 uppercase text-[10px] block font-black">💊 Posologia & Administração:</strong>
                        <p class="text-gray-700">${item.dose}</p>
                    </div>
                `;
                activeModalData = `💉 *ANTÍDOTO:* ${item.nome}\n*Apresentação:* ${item.apresentacao}\n*Indicação:* ${item.indicacao}\n*Posologia:* ${item.dose}`;
            } else if (tipo === 'peconha') {
                const item = peconhaData[index];
                catBadge.innerText = item.tipo;
                body.innerHTML = `
                    <h2 class="text-base font-black text-gray-900">${item.nome}</h2>
                    <div>
                        <strong class="text-amber-800 uppercase text-[10px] block font-black">🔍 Quadro Clínico:</strong>
                        <p class="text-gray-700">${item.quadro}</p>
                    </div>
                    <div>
                        <strong class="text-emerald-800 uppercase text-[10px] block font-black">📋 Conduta & Soroterapia:</strong>
                        <p class="text-gray-700 whitespace-pre-line">${item.conduta}</p>
                    </div>
                `;
                activeModalData = `🐍 *ANIMAL PEÇONHENTO:* ${item.nome}\n\n*Conduta & Soroterapia:*\n${item.conduta}`;
            } else if (tipo === 'prescricao') {
                const item = prescricoesData[index];
                catBadge.innerText = item.categoria;
                body.innerHTML = `
                    <h2 class="text-base font-black text-gray-900">${item.titulo}</h2>
                    <div>
                        <strong class="text-blue-800 uppercase text-[10px] block font-black">📋 Protocolo Clínico:</strong>
                        <p class="text-gray-700 whitespace-pre-line font-medium leading-relaxed">${item.conteudo}</p>
                    </div>
                `;
                activeModalData = `📋 *PROTOCOLO CLÍNICO:* ${item.titulo}\n\n${item.conteudo}`;
            } else if (tipo === 'dmhas') {
                const item = dmhasData[index];
                catBadge.innerText = item.categoria;
                body.innerHTML = `
                    <h2 class="text-base font-black text-gray-900">${item.titulo}</h2>
                    <div>
                        <strong class="text-purple-800 uppercase text-[10px] block font-black">📋 Diretriz Terapêutica:</strong>
                        <p class="text-gray-700 whitespace-pre-line font-medium leading-relaxed">${item.conteudo}</p>
                    </div>
                `;
                activeModalData = `🫀 *DIRETRIZ CLÍNICA:* ${item.titulo}\n\n${item.conteudo}`;
            }

            modal.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('detailModal').classList.add('hidden');
            activeModalData = null;
        }

        // Envio do card aberto diretamente para o chat do Telegram
        function compartilharItemModal() {
            if (!activeModalData) return;

            if (tg) {
                tg.sendData(activeModalData);
            } else {
                console.log(activeModalData);
                alert("Nativo do Telegram Web App!\n\nDados a enviar:\n\n" + activeModalData);
            }
        }

        // Inicializar renderização
        document.addEventListener('DOMContentLoaded', () => {
            renderAll();
        });
    </script>
</body>
